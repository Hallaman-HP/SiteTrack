# SiteTrack backend configuration
# Copy to .env (same directory) and fill in. This file must never be web-readable:
# keep the server/ directory above the docroot, or rely on the .htaccess deny rules.

# --- Database (cPanel MySQL/MariaDB) ---
DB_HOST=localhost
DB_NAME=sitetrack
DB_USER=sitetrack
DB_PASS=change-me

# --- App ---
# Public origin of the frontend (no trailing slash). Used to build email links
# (magic link, verification, password reset, invites) and to decide Secure cookies.
APP_URL=https://sitetrack.example.com.au

# Absolute path OUTSIDE the docroot for uploaded files (avatars).
UPLOADS_DIR=/home/youruser/sitetrack-uploads

# --- Mail ---
MAIL_FROM_ADDRESS=no-reply@sitetrack.example.com.au
MAIL_FROM_NAME=SiteTrack
# Optional SMTP. If SMTP_HOST is empty, PHP mail() is used by the cron dispatcher.
# Port 465 = implicit TLS, 587 = STARTTLS, other = plain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Auth ---
# Session cookie lifetime in days (rolling).
SESSION_DAYS=30
# Trusted-device (2FA skip) cookie lifetime in days.
TRUST_DAYS=7
# 1 = users must verify their email before they can log in.
REQUIRE_EMAIL_VERIFY=1
# 1 = password logins require an emailed 6-digit code unless the device is trusted.
REQUIRE_2FA=1
